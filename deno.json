{
	"imports": {
		"@/": "./",
		"@fresh/core": "jsr:@fresh/core@^2.3.3",
		"fresh": "jsr:@fresh/core@^2.3.3",
		"@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
		"@preact/signals": "npm:@preact/signals@^2.11.3",
		"preact": "npm:preact@^10.29.8",
		"vite": "npm:vite@^7.3.1"
	},
	"tasks": {
		"dev": "deno run -A vite",
		"build": "deno run -A vite build",
		"start": "deno serve -A _fresh/server.js"
	},
	"compilerOptions": {
		"jsx": "precompile",
		"jsxImportSource": "preact",
		"lib": ["deno.window", "dom"]
	},
	"nodeModulesDir": "auto"
}
